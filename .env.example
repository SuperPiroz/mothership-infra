# ==============================================================================
# Mothership Dashboard - Lokal utvecklingskonfiguration (.env.example)
# Kopiera denna fil till .env för lokal körning: cp .env.example .env
# OBS: Riktiga lösenord eller API-nycklar får ALDRIG committas till Git!
# ==============================================================================

# --- Miljö ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- Databas: PostgreSQL (för mothership-core) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=mothership_core
POSTGRES_USER=core_user
POSTGRES_PASSWORD=devpassword123

# --- Databas: MySQL (för mothership-pulse) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=mothership_pulse
MYSQL_USER=pulse_user
MYSQL_PASSWORD=devpassword123
MYSQL_ROOT_PASSWORD=devrootpassword123

# --- mothership-core API (Python FastAPI) ---
CORE_PORT=8000
JWT_SECRET_KEY=insecure-dev-secret-key-change-in-production-only-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=adminpassword123

# --- mothership-pulse API (Go) ---
PULSE_PORT=8080
PULSE_POLL_INTERVAL_SECONDS=30

# --- mothership-web Frontend (React Vite) ---
WEB_PORT=3000
VITE_CORE_API_URL=http://localhost:8000
VITE_PULSE_API_URL=http://localhost:8080
